# Postgres connection string (Supabase, Neon, Vercel Postgres, or local)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Free key from https://the-odds-api.com — used to pull DraftKings lines & scores
ODDS_API_KEY=

# Any random string; protects the /api/cron/sync-week endpoint from strangers
CRON_SECRET=change-me
